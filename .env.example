# Property Intelligence — exemplo de configurações locais .env

# Banco de dados principal
DATABASE_URL=postgres://property_intelligence:property_intelligence@localhost:5432/property_intelligence
# Cache Redis
REDIS_URL=redis://localhost:6379

# Chave da API utilizada para autenticação de clientes
# (Consulte o mantenedor para um valor válido em produção)
API_KEY=
# Sal para hashing seguro das API keys do consumidor
API_KEY_SALT=dev-salt-32-chars-placeholder-ok

# Chave do OpenRouter (para chamadas LLM via OpenAI compatible endpoint)
OPENROUTER_API_KEY=changeme
# O modelo de LLM a ser usado (free: meta-llama/llama-3.1-8b-instruct:free)
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Chave de API do IPTU (https://iptuapi.com.br, free tier para dev)
IPTU_API_KEY=changeme

# Cloudflare Tunnel (opcional para dev; obrigatório só em staging/prod)
CLOUDFLARE_TUNNEL_TOKEN=

# Logs e metrics — integração com Grafana Cloud OTLP (opcional)
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_TOKEN=

